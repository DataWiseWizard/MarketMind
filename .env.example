# ===========================================
# MarketMind Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ---- Database ----
DATABASE_URL=postgresql://marketmind_user:your_password_here@localhost:5432/marketmind_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=marketmind_db
DB_USER=marketmind_user
DB_PASSWORD=your_password_here

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# ---- Paths ----
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
REPORTS_DIR=reports

# ---- Hugging Face ----
# Optional: set if you need private models
# HF_TOKEN=your_huggingface_token_here

# ---- Market Data ----
# yfinance doesn't need an API key
# Optional alternatives:
# ALPHA_VANTAGE_API_KEY=your_key_here
# FINNHUB_API_KEY=your_key_here

# ---- MLflow ----
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=marketmind

# ---- LLM (Optional - for RAG) ----
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL=mistral

# ---- Disclaimer ----
# This project is for educational and research purposes only.
# Not financial advice. Do not use for real trading.
