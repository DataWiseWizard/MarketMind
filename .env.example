# ===========================================
# MarketMind Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ---- Database ----
# Defaults to SQLite in data/marketmind.db if not specified
DATABASE_URL=sqlite:///data/marketmind.db

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False

# ---- Paths ----
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
REPORTS_DIR=reports

# ---- MLflow ----
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=marketmind

# ---- Gemini AI Analyst & RAG Agent ----
# Get free key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ---- Streamlit Dashboard ----
MARKETMIND_API_URL=http://localhost:8000

# ---- Disclaimer ----
# This project is for educational and research purposes only.
# Not financial advice. Do not use for real trading.