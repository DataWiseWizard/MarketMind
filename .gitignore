.ipynb_checkpoints/

# Data (large files - don't commit raw data)
data/raw/audio/
data/raw/market_data/
data/processed/
data/external/
*.wav
*.mp3
*.mp4

# Keep folder structure with .gitkeep
!data/raw/audio/.gitkeep
!data/raw/transcripts/.gitkeep
!data/raw/filings/.gitkeep
!data/raw/market_data/.gitkeep
!data/processed/transcripts/.gitkeep
!data/processed/features/.gitkeep
!data/processed/embeddings/.gitkeep
!data/external/.gitkeep

# MLflow
mlruns/
mlflow/artifacts/

# Reports (generated)
reports/*.pdf
reports/*.html

# Database
*.db
*.sqlite3

# OS
.DS_Store
Thumbs.db

